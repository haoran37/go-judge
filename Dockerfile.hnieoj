ARG GO_BUILDER_IMAGE=golang:1.26-bookworm
ARG DEBIAN_RUNTIME_IMAGE=debian:bookworm-slim

FROM ${GO_BUILDER_IMAGE} AS builder

ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=sum.golang.google.cn

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -trimpath -ldflags="-s -w" -o /out/go-judge ./cmd/go-judge \
    && go build -trimpath -ldflags="-s -w" -o /out/hnieoj-judge-node ./cmd/hnieoj-judge-node

FROM ${DEBIAN_RUNTIME_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_MIRROR=deb.debian.org
ENV TZ=Asia/Shanghai

RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
        gcc \
        g++ \
        openjdk-17-jdk-headless \
        python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/go-judge

COPY --from=builder /out/go-judge /usr/local/bin/go-judge
COPY --from=builder /out/hnieoj-judge-node /usr/local/bin/hnieoj-judge-node
COPY mount.yaml /opt/go-judge/mount.yaml

EXPOSE 3723

CMD ["/usr/local/bin/hnieoj-judge-node"]
